# Aware server settings. Copy to .env and adjust per deployment.

# The single domain nginx serves.
DOMAIN=example.com

# Certificate paths. These examples follow certbot paths
SSL_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/example.com/privkey.pem
SSL_CHAIN=/etc/letsencrypt/live/example.com/chain.pem

# MySQL login for uploaded data. INSERT only; the tables must already exist.
MYSQL_HOST=db.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=aware
MYSQL_USER=aware_writer
MYSQL_PASSWORD=example-password

# True registers a catch-all endpoint that logs full request contents. Development only.
DEBUG=False
